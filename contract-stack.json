{
  "schema": "ores.contract-stack/v1",
  "repository": "ORESoftware/ores-interfaces",
  "authority": {
    "role": "shared-contract-registry",
    "model": "independent-typespec-and-json-schema-peers"
  },
  "tools": {
    "wireAndRuntimeConformance": {
      "repository": "ORESoftware/typespec-json-schema-validator",
      "commit": "a9db1298cd4c993744a7b24bbc8f0ae9d1d0a33a",
      "requiredFor": [
        "wire-parity",
        "contract-ir",
        "runtime-conformance"
      ]
    },
    "persistenceConvergence": {
      "repository": "ORESoftware/ores-contracts",
      "commit": "c02bd2cd2f057b5384b50cb39ddda3dd926a4ca5",
      "requiredFor": [
        "declared-persistence-subset"
      ]
    },
    "witProjectionCompatibility": {
      "repository": "ORESoftware/typespec-json-schema-validator",
      "commit": "f56a730fce9b77dc3dd19a68e4e556cd3296af8c",
      "export": "@oresoftware/typespec-json-schema-validator/wit-compatibility",
      "cli": "tjsv verify-wit",
      "role": "downstream-projection-evidence-only",
      "promotionRole": "necessary-not-sufficient",
      "composedReleaseGate": {
        "status": "pending-implementation",
        "tracker": "ORESoftware/typespec-json-schema-validator#221",
        "mustBind": [
          "parity-contract-ir",
          "wit-projection-verification",
          "ores-wit-toolchain-receipt",
          "wit-baseline-provenance",
          "wit-compatibility-receipt"
        ]
      },
      "requiredFor": [
        "wit-projection-compatibility",
        "native-sdk-contract-evidence",
        "component-sdk-promotion"
      ],
      "defaultMode": "strict",
      "targets": [
        "native-sdk",
        "wasm-component"
      ]
    }
  },
  "orchestrator": {
    "repository": "ORESoftware/ores-cli",
    "role": "resolved-version-policy-only"
  },
  "legacyCompatibilityManifest": "shared-interfaces.json"
}
