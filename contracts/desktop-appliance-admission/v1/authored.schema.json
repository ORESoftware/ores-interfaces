{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/desktop/appliance-admission/v1.json",
  "title": "ORES desktop appliance admission projection v1",
  "description": "Portable fleet-shared admission facts projected from a product desktop appliance. Runtime and product-specific semantics remain outside this wire contract.",
  "$defs": {
    "CommonLayerAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["repository", "checkout_dir", "status", "revision", "capabilities"],
      "properties": {
        "repository": {"type": "string", "const": "ORESoftware/ores-common-desktop-infra"},
        "checkout_dir": {"type": "string", "const": "tmp/dev/ores-common-desktop-infra"},
        "status": {"type": "string", "const": "pinned"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"type": "string"}
        }
      }
    },
    "OrchestratorAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["engine", "config"],
      "properties": {
        "engine": {"type": "string", "const": "ores-compose"},
        "config": {"type": "string", "const": ".ores-compose.yaml"}
      }
    },
    "HostAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["daemon_host", "daemon_port", "requires_public_ip"],
      "properties": {
        "daemon_host": {"type": "string", "const": "127.0.0.1"},
        "daemon_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "requires_public_ip": {"type": "boolean", "const": false}
      }
    },
    "CloudflareAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["mode", "credentials_in_repo", "origin_auth"],
      "properties": {
        "mode": {"anyOf": [
          {"type": "string", "const": "not-required"},
          {"type": "string", "const": "gated"},
          {"type": "string", "const": "remotely-managed"}
        ]},
        "credentials_in_repo": {"type": "boolean", "const": false},
        "origin_auth": {"anyOf": [
          {"type": "string", "const": "outbound-agent-only"},
          {"type": "string", "const": "dedicated-remote-auth-required"},
          {"type": "string", "const": "dedicated-remote-auth"}
        ]},
        "token_source": {"type": "string", "const": "file"},
        "token_file_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "hostname_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "UpdateAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["mode", "allow_mutable_latest"],
      "properties": {
        "mode": {"type": "string", "const": "exact-revision"},
        "allow_mutable_latest": {"type": "boolean", "const": false}
      }
    },
    "PromotionGates": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["common_layer_pinned", "common_layer_ci_verified"],
      "properties": {
        "common_layer_pinned": {"type": "boolean", "const": true},
        "common_layer_ci_verified": {"type": "boolean"}
      }
    },
    "DesktopApplianceAdmission": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema", "product", "channel", "common_layer", "orchestrator", "host", "cloudflare", "update", "promotion_gates"],
      "properties": {
        "schema": {"type": "string", "const": "ores.desktop-appliance-admission/v1"},
        "product": {"type": "string", "minLength": 1, "maxLength": 128},
        "channel": {"type": "string", "minLength": 1, "maxLength": 64},
        "common_layer": {"$ref": "#/$defs/CommonLayerAdmission"},
        "orchestrator": {"$ref": "#/$defs/OrchestratorAdmission"},
        "host": {"$ref": "#/$defs/HostAdmission"},
        "cloudflare": {"$ref": "#/$defs/CloudflareAdmission"},
        "update": {"$ref": "#/$defs/UpdateAdmission"},
        "promotion_gates": {"$ref": "#/$defs/PromotionGates"}
      }
    }
  }
}
