{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.com/schemas/desktop-daemon/v1",
  "title": "DesktopDaemonV1",
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
    },
    "WorkerActivation": {
      "type": "string",
      "enum": ["reuse", "start_child", "restart_child", "beam_hot_load"]
    },
    "DevicePlatform": {
      "type": "string",
      "enum": ["desktop", "android", "ios"]
    },
    "HostingRole": {
      "type": "string",
      "enum": ["client_only", "client_and_worker", "client_and_server"]
    },
    "ResolvedSourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "immutable_revision", "content_sha256"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "immutable_revision": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/Sha256Hex" }
      }
    },
    "WorkerDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "revision", "content_sha256", "activation"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "content_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "activation": { "$ref": "#/$defs/WorkerActivation" }
      }
    },
    "DocsArtifactPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_docs_revision", "publication_mode", "semantic_contract_sha256", "route_catalog_sha256", "output_dir"],
      "properties": {
        "api_docs_revision": { "$ref": "#/$defs/GitObjectId" },
        "publication_mode": { "const": "consumer_owned" },
        "semantic_contract_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "route_catalog_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "output_dir": { "type": "string", "minLength": 1 }
      }
    },
    "DeploymentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment_id", "product_id", "generation", "source_evidence", "compose_sha256", "route_catalog_sha256", "workers", "full_appliance_restart_required"],
      "properties": {
        "deployment_id": { "type": "string", "minLength": 1 },
        "product_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ResolvedSourceEvidence" }
        },
        "compose_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "route_catalog_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "workers": {
          "type": "array",
          "items": { "$ref": "#/$defs/WorkerDeployment" }
        },
        "docs": { "$ref": "#/$defs/DocsArtifactPlan" },
        "full_appliance_restart_required": { "const": false }
      }
    },
    "DeviceCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "hosting_role", "supports_wasm", "supports_native_workers", "supports_persistent_service", "supports_inbound_listener", "background_execution_limited"],
      "properties": {
        "platform": { "$ref": "#/$defs/DevicePlatform" },
        "hosting_role": { "$ref": "#/$defs/HostingRole" },
        "supports_wasm": { "type": "boolean" },
        "supports_native_workers": { "type": "boolean" },
        "supports_persistent_service": { "type": "boolean" },
        "supports_inbound_listener": { "type": "boolean" },
        "background_execution_limited": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/DeploymentPlan" },
    { "$ref": "#/$defs/DeviceCapabilities" }
  ]
}
