{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.com/schemas/desktop-infra/v1",
  "title": "DesktopInfraV1",
  "$defs": {
    "RouteAuthority": {
      "type": "string",
      "enum": ["erlang", "rust"]
    },
    "LoopbackHost": {
      "type": "string",
      "enum": ["127.0.0.1", "::1"]
    },
    "RouteTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "$ref": "#/$defs/LoopbackHost" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "RouteSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "host", "path_prefix", "target", "public"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "path_prefix": { "type": "string", "pattern": "^/" },
        "target": { "$ref": "#/$defs/RouteTarget" },
        "public": { "type": "boolean" }
      }
    },
    "ServiceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "revision", "digest", "command_id", "hot_reloadable"],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "command_id": { "type": "string", "minLength": 1 },
        "health_endpoint": { "$ref": "#/$defs/RouteTarget" },
        "hot_reloadable": { "type": "boolean" }
      }
    },
    "DesiredState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "generation", "route_authority", "routes", "services", "labels"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "route_authority": { "$ref": "#/$defs/RouteAuthority" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/RouteSpec" } },
        "services": { "type": "array", "items": { "$ref": "#/$defs/ServiceSpec" } },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "$ref": "#/$defs/DesiredState"
}
