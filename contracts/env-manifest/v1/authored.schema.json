{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/config/env-manifest/v1.json",
  "title": "ORES environment override metadata",
  "description": "Independent JSON Schema authority for environment override declarations and deterministic resolved manifests.",
  "$defs": {
    "EnvOverrideDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "kind", "required", "secret", "exposure", "description", "overrides", "environments"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
        "key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "kind": {"anyOf": [
          {"type": "string", "const": "string"}, {"type": "string", "const": "bool"},
          {"type": "string", "const": "integer"}, {"type": "string", "const": "double"},
          {"type": "string", "const": "json"}, {"type": "string", "const": "url"},
          {"type": "string", "const": "duration-ms"}, {"type": "string", "const": "string-list"},
          {"type": "string", "const": "integer-list"}
        ]},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "exposure": {"anyOf": [{"type": "string", "const": "env-only"}, {"type": "string", "const": "argv-and-env"}]},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "overrides": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
        "environments": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"anyOf": [
          {"type": "string", "const": "dev"}, {"type": "string", "const": "stage"}, {"type": "string", "const": "prod"}
        ]}},
        "defaultValue": {"type": "string", "maxLength": 8192}
      }
    },
    "ResolvedEnvVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "required", "secret", "exposure", "description", "overrides", "environments", "sources"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "kind": {"anyOf": [
          {"type": "string", "const": "string"}, {"type": "string", "const": "bool"},
          {"type": "string", "const": "integer"}, {"type": "string", "const": "double"},
          {"type": "string", "const": "json"}, {"type": "string", "const": "url"},
          {"type": "string", "const": "duration-ms"}, {"type": "string", "const": "string-list"},
          {"type": "string", "const": "integer-list"}
        ]},
        "required": {"type": "boolean"},
        "secret": {"type": "boolean"},
        "exposure": {"anyOf": [{"type": "string", "const": "env-only"}, {"type": "string", "const": "argv-and-env"}]},
        "description": {"type": "string", "minLength": 1, "maxLength": 512},
        "overrides": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
        "environments": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"anyOf": [
          {"type": "string", "const": "dev"}, {"type": "string", "const": "stage"}, {"type": "string", "const": "prod"}
        ]}},
        "sources": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
        "defaultValue": {"type": "string", "maxLength": 8192}
      }
    },
    "EnvManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "variables"],
      "properties": {
        "schemaVersion": {"type": "string", "const": "ores.env-manifest.v1"},
        "variables": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/ResolvedEnvVariable"}}
      }
    }
  }
}
