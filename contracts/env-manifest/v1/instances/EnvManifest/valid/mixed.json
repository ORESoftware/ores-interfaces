{
  "schemaVersion": "ores.env-manifest.v1",
  "variables": [
    {
      "key": "DATABASE_URL",
      "kind": "url",
      "required": true,
      "secret": true,
      "exposure": "env-only",
      "description": "Database credential URI.",
      "overrides": ["server.database_url"],
      "environments": ["dev", "prod"],
      "sources": [".ores-forms.toml"]
    },
    {
      "key": "PORT",
      "kind": "integer",
      "required": false,
      "secret": false,
      "exposure": "argv-and-env",
      "description": "HTTP listener port.",
      "overrides": ["server.port"],
      "environments": ["dev", "prod"],
      "sources": [".ores-forms.toml"],
      "defaultValue": "8080"
    }
  ]
}
