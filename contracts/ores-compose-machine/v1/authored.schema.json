{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oresoftware.com/compose/machine/v1.json",
  "title": "ORES Compose machine control contract v1",
  "description": "Independent JSON Schema authority for serialized ores-compose machine ensure, queue status, readiness, error, and switch-failure diagnostic messages.",
  "$defs": {
    "EnsureRequest": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "project", "session", "service", "revision", "rebuild"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "project": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "session": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "service": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?![-/])(?!.*\\.\\.)(?!.*//)(?!.*@\\{)(?!.*\\/\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9._/-]*[A-Za-z0-9_/-]$"},
        "rebuild": {"type": "boolean"}
      }
    },
    "EnqueueResponse": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "job_id", "deduplicated", "state"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"},
        "deduplicated": {"type": "boolean"},
        "state": {"anyOf": [{"type": "string", "const": "queued"}, {"type": "string", "const": "running"}]}
      }
    },
    "MachineIngress": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["kind", "authority"],
      "properties": {
        "kind": {"anyOf": [{"type": "string", "const": "tcp"}, {"type": "string", "const": "unix"}]},
        "authority": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?:127\\.|\\[::1\\]:|/)"}
      }
    },
    "ActiveSystem": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["project", "session", "revision", "generation"],
      "properties": {
        "project": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "session": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?![-/])(?!.*\\.\\.)(?!.*//)(?!.*@\\{)(?!.*\\/\\.)(?!.*\\.lock(?:/|$))[A-Za-z0-9._/-]*[A-Za-z0-9_/-]$"},
        "generation": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"},
        "ingress": {"$ref": "#/$defs/MachineIngress"}
      }
    },
    "JobStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "job_id", "state"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"},
        "state": {"anyOf": [
          {"type": "string", "const": "queued"},
          {"type": "string", "const": "running"},
          {"type": "string", "const": "ready"},
          {"type": "string", "const": "failed"}
        ]},
        "active": {"$ref": "#/$defs/ActiveSystem"}
      }
    },
    "ReadinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "ready"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "ready": {"type": "boolean"},
        "active": {"$ref": "#/$defs/ActiveSystem"}
      }
    },
    "MachineErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "code", "message"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "code": {"anyOf": [
          {"type": "string", "const": "invalid_request"},
          {"type": "string", "const": "unknown_project"},
          {"type": "string", "const": "unknown_service"},
          {"type": "string", "const": "lazy_start_denied"},
          {"type": "string", "const": "queue_full"},
          {"type": "string", "const": "machine_busy"},
          {"type": "string", "const": "job_not_found"},
          {"type": "string", "const": "stale_generation"},
          {"type": "string", "const": "activation_failed"},
          {"type": "string", "const": "ingress_unavailable"},
          {"type": "string", "const": "internal_state_poisoned"},
          {"type": "string", "const": "server_busy"},
          {"type": "string", "const": "request_timeout"},
          {"type": "string", "const": "headers_too_large"}
        ]},
        "message": {"type": "string", "minLength": 1, "maxLength": 512},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"}
      }
    },
    "SwitchPhase": {
      "type": "string",
      "enum": [
        "confirm_ready",
        "drain_active",
        "stop_active",
        "fetch_revision",
        "checkout_revision",
        "rebuild",
        "configure_network",
        "start_system",
        "await_readiness",
        "publish_ingress"
      ]
    },
    "SwitchFailureCode": {
      "type": "string",
      "enum": [
        "confirm_ready_failed",
        "drain_active_failed",
        "stop_active_failed",
        "fetch_revision_failed",
        "checkout_revision_failed",
        "rebuild_failed",
        "configure_network_failed",
        "start_system_failed",
        "await_readiness_failed",
        "publish_ingress_failed"
      ]
    },
    "SwitchFailureDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "unevaluatedProperties": false,
      "required": ["schema_version", "job_id", "generation", "phase", "code", "message"],
      "properties": {
        "schema_version": {"type": "string", "const": "ores.compose.machine.v1"},
        "job_id": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"},
        "generation": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^[1-9][0-9]{0,19}$"},
        "phase": {"$ref": "#/$defs/SwitchPhase"},
        "code": {"$ref": "#/$defs/SwitchFailureCode"},
        "message": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
