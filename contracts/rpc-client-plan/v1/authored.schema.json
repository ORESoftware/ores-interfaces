{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/ores-interfaces/raw/main/contracts/rpc-client-plan/v1/authored.schema.json",
  "title": "ORES RPC client request plan v1",
  "description": "Every declaration has a named peer under $defs so TJSV compares it with the TypeSpec declaration of the same name. A document is an RpcRequestPlan.",
  "$ref": "#/$defs/RpcRequestPlan",
  "$defs": {
    "RpcAuthMode": {
      "type": "string",
      "enum": [
        "default",
        "omitted",
        "bearer_override"
      ]
    },
    "RpcBackpressure": {
      "type": "string",
      "enum": [
        "buffer",
        "drop_oldest",
        "drop_newest",
        "error"
      ]
    },
    "RpcCompression": {
      "type": "string",
      "enum": [
        "identity",
        "gzip",
        "brotli",
        "zstd"
      ]
    },
    "RpcHeaders": {
      "description": "Normalized request headers. Redaction is applied at the plan boundary, not per option: any header whose name matches the client redaction lists is replaced with the redaction placeholder before serialization, whatever wrote it. A credential value therefore cannot appear here even though the shape admits arbitrary header names.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$"
      },
      "properties": {},
      "unevaluatedProperties": {}
    },
    "RpcIpVersion": {
      "type": "string",
      "enum": [
        "v4",
        "v6"
      ]
    },
    "RpcPathFields": {
      "type": "object",
      "description": "Path-template fields, by placeholder name.",
      "properties": {},
      "unevaluatedProperties": {}
    },
    "RpcQuery": {
      "description": "Request query fields. Redacted at the plan boundary exactly as headers are: a field whose name matches the client redaction lists carries the placeholder, whatever wrote it. The pattern pins the canonical lowercase spellings; clients match case-insensitively, which a JSON Schema pattern cannot express.",
      "type": "object",
      "patternProperties": {
        "^(access[-_]token|api[-_]key|apikey|auth|password|secret|sig|signature|token)$": {
          "const": "[redacted]"
        }
      },
      "properties": {},
      "unevaluatedProperties": {}
    },
    "RpcRequestPlan": {
      "description": "Fleet-shared canonical serialization of a fully built RPC client chain. Peer authority to main.tsp; TJSV owns semantic comparison between them. ORESoftware/api-docs owns the option catalog that produces plans and keeps a consumer-side copy of this contract for its own generation gate; generated schemas and generated clients are evidence, never a third authority. A plan is the cross-language conformance unit: the same chain in Rust, TypeScript, Dart, Go and Gleam must serialize to a byte-identical plan. Plans never carry credentials.",
      "type": "object",
      "required": [
        "plan_version",
        "kind",
        "key",
        "rpc_path",
        "serial_strategy"
      ],
      "properties": {
        "plan_version": {
          "const": "1.0.0"
        },
        "kind": {
          "$ref": "#/$defs/RpcSurface"
        },
        "key": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
          "description": "Canonical dotted rpc_key, identical to rpc-operation/v1's operation_key grammar. A plan names an operation, so the two contracts must agree on what an operation may be called. ORESoftware/api-docs additionally admits a legacy single-identifier spelling inside its own consumer copy during migration; that affordance is deliberately not part of the fleet contract."
        },
        "rpc_path": {
          "type": "string",
          "pattern": "^/.*",
          "default": "/v1/rpc"
        },
        "transport": {
          "$ref": "#/$defs/RpcTransport"
        },
        "headers": {
          "$ref": "#/$defs/RpcHeaders"
        },
        "path": {
          "$ref": "#/$defs/RpcPathFields"
        },
        "query": {
          "$ref": "#/$defs/RpcQuery"
        },
        "body": {},
        "serial_strategy": {
          "$ref": "#/$defs/RpcSerialStrategy"
        },
        "compression": {
          "$ref": "#/$defs/RpcCompression"
        },
        "timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "deadline_unix_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Absolute deadline in Unix milliseconds. Bounded by Number.MAX_SAFE_INTEGER because the plan is JSON and must round-trip exactly in runtimes with double-precision numbers; a larger value would compare unequal across languages and break plan parity."
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "retry_backoff": {
          "$ref": "#/$defs/RpcRetryBackoff"
        },
        "retry_hook_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "auth_mode": {
          "$ref": "#/$defs/RpcAuthMode",
          "description": "bearer_override records that a per-call credential was supplied. The credential itself is never serialized into a plan."
        },
        "skip_local_cache": {
          "type": "boolean"
        },
        "require_fresh": {
          "type": "boolean"
        },
        "skip_edge_cache": {
          "type": "boolean"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "const": "00000000000000000000000000000000"
          },
          "description": "W3C trace-context trace-id: 32 lowercase hex digits, not all zero. This is dynamic per-invocation context, distinct from the static ores_trace_id source identity carried by the RPC error-log contract."
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "not": {
            "const": "0000000000000000"
          },
          "description": "W3C trace-context parent span-id: 16 lowercase hex digits, not all zero."
        },
        "debug": {
          "type": "boolean"
        },
        "new_agent": {
          "type": "boolean"
        },
        "proxy_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*://(?:redacted@)?[^@/?#]*(?:[/?#].*)?$",
          "description": "Proxy endpoint. Userinfo is replaced before serialization with the literal 'redacted', so user:password@host cannot appear. Not '[redacted]': square brackets are not valid RFC 3986 userinfo, so that spelling made every redacted proxy URL fail the uri format asserted here."
        },
        "ip_version": {
          "$ref": "#/$defs/RpcIpVersion"
        },
        "keep_alive": {
          "type": "boolean"
        },
        "skip_tls_verify": {
          "type": "boolean"
        },
        "queue_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "concurrency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "drop_if_busy": {
          "type": "boolean"
        },
        "delay_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "jitter_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "upload_progress_hook_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "download_progress_hook_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "fallback": {},
        "cache_ttl_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "stale_while_revalidate_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "dry_run": {
          "type": "boolean"
        },
        "dedupe": {
          "type": "boolean"
        },
        "throttle_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "debounce_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "backpressure": {
          "$ref": "#/$defs/RpcBackpressure"
        },
        "stream_buffer_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "stream_idle_timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        },
        "sample_each_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "throttle_each_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "debounce_each_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "allOf": [
        {
          "title": "Streaming plans reject unary-only shaping",
          "if": {
            "properties": {
              "kind": {
                "const": "stream"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "fallback"
                  ]
                },
                {
                  "required": [
                    "cache_ttl_seconds"
                  ]
                },
                {
                  "required": [
                    "stale_while_revalidate_seconds"
                  ]
                },
                {
                  "required": [
                    "dry_run"
                  ]
                },
                {
                  "required": [
                    "dedupe"
                  ]
                },
                {
                  "required": [
                    "throttle_millis"
                  ]
                },
                {
                  "required": [
                    "debounce_millis"
                  ]
                }
              ]
            }
          }
        },
        {
          "title": "Unary plans reject stream-only shaping",
          "if": {
            "properties": {
              "kind": {
                "const": "unary"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "backpressure"
                  ]
                },
                {
                  "required": [
                    "stream_buffer_capacity"
                  ]
                },
                {
                  "required": [
                    "stream_idle_timeout_millis"
                  ]
                },
                {
                  "required": [
                    "sample_each_millis"
                  ]
                },
                {
                  "required": [
                    "throttle_each_millis"
                  ]
                },
                {
                  "required": [
                    "debounce_each_millis"
                  ]
                }
              ]
            }
          }
        },
        {
          "title": "Unary outbound rate shaping is mutually exclusive",
          "not": {
            "required": [
              "throttle_millis",
              "debounce_millis"
            ]
          }
        },
        {
          "title": "Stream inbound rate shaping is mutually exclusive",
          "allOf": [
            {
              "not": {
                "required": [
                  "sample_each_millis",
                  "throttle_each_millis"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "sample_each_millis",
                  "debounce_each_millis"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "throttle_each_millis",
                  "debounce_each_millis"
                ]
              }
            }
          ]
        },
        {
          "title": "A retry backoff schedule requires a retry budget",
          "if": {
            "required": [
              "retry_backoff"
            ]
          },
          "then": {
            "required": [
              "retry_count"
            ]
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "RpcRetryBackoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_millis",
        "factor"
      ],
      "properties": {
        "base_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "factor": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "RpcSerialStrategy": {
      "type": "string",
      "enum": [
        "json",
        "message_pack",
        "protobuf"
      ]
    },
    "RpcSurface": {
      "type": "string",
      "enum": [
        "unary",
        "stream"
      ]
    },
    "RpcTransport": {
      "type": "string",
      "enum": [
        "http",
        "tcp",
        "websocket",
        "nats"
      ]
    }
  }
}
