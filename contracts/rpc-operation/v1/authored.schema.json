{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/ores-interfaces/raw/main/contracts/rpc-operation/v1/authored.schema.json",
  "title": "ORES normalized RPC operation v1",
  "description": "Language-neutral operation IR emitted from one Rust route.rs HTTP handler plus peer TypeSpec/JSON-Schema contracts. Client generators for Rust, Go, Dart, TypeScript and Gleam consume this shape; the API server uses the same operation identity to build /v1/rpc dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_key",
    "namespace",
    "source",
    "http",
    "scope",
    "audiences",
    "codecs",
    "request",
    "response",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "namespace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_file", "handler"],
      "properties": {
        "route_file": { "type": "string", "pattern": "(^|/)route\\.rs$" },
        "handler": {
          "type": "string",
          "enum": ["get", "post", "put", "patch", "delete", "head", "options"]
        },
        "repository": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "rpc_transport_path"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": { "type": "string", "pattern": "^/" },
        "rpc_transport_path": { "const": "/v1/rpc" }
      }
    },
    "scope": { "type": "string", "enum": ["regular", "admin"] },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["browser", "server"] }
    },
    "codecs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "default"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["json", "protobuf", "messagepack"] }
        },
        "default": { "type": "string", "enum": ["json", "protobuf", "messagepack"] }
      }
    },
    "request": { "$ref": "#/$defs/requestShape" },
    "response": { "$ref": "#/$defs/responseShape" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "schemaRef": {
      "oneOf": [
        { "type": "object" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "requestShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_schema": { "$ref": "#/$defs/schemaRef" },
        "query_schema": { "$ref": "#/$defs/schemaRef" },
        "header_schema": { "$ref": "#/$defs/schemaRef" },
        "body_schema": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "responseShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header_schema": { "$ref": "#/$defs/schemaRef" },
        "trailer_schema": { "$ref": "#/$defs/schemaRef" },
        "body_schema": { "$ref": "#/$defs/schemaRef" },
        "error_schema": { "$ref": "#/$defs/schemaRef" }
      }
    }
  }
}
