{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/ores-interfaces/raw/main/contracts/rpc-operation/v1/authored.schema.json",
  "title": "ORES normalized RPC operation v1",
  "description": "Language-neutral operation IR emitted from one authoritative Rust handlers.rs operation plus peer TypeSpec/JSON-Schema contracts. route.rs and REST metadata are optional HTTP projections. Client generators for Rust, Go, Dart, TypeScript and Gleam consume this shape; the API server uses the same operation identity to build POST /v1/rpc dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_key",
    "namespace",
    "source",
    "rpc_transport_path",
    "scope",
    "audiences",
    "codecs",
    "request",
    "response",
    "contract_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "namespace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handlers_file", "operation"],
      "properties": {
        "handlers_file": { "type": "string", "pattern": "(^|/)handlers\\.rs$" },
        "operation": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "route_file": { "type": "string", "pattern": "(^|/)route\\.rs$" },
        "route_handler": {
          "type": "string",
          "enum": ["get", "post", "put", "patch", "delete", "head", "options"]
        },
        "repository": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "dependentRequired": {
        "route_file": ["route_handler"],
        "route_handler": ["route_file"]
      }
    },
    "rpc_transport_path": { "const": "/v1/rpc" },
    "stream": {
      "type": "string",
      "enum": ["unary", "server_stream", "client_stream", "bidi"],
      "description": "RPC streaming mode. When absent, consumers must preserve legacy unary semantics."
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
        },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "scope": { "type": "string", "enum": ["regular", "admin"] },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["browser", "server"] }
    },
    "codecs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "default"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["json", "protobuf", "messagepack"] }
        },
        "default": { "type": "string", "enum": ["json", "protobuf", "messagepack"] }
      }
    },
    "request": { "$ref": "#/$defs/requestShape" },
    "response": { "$ref": "#/$defs/responseShape" },
    "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "schemaRef": {
      "oneOf": [
        { "type": "object" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "requestShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path_schema": { "$ref": "#/$defs/schemaRef" },
        "query_schema": { "$ref": "#/$defs/schemaRef" },
        "header_schema": { "$ref": "#/$defs/schemaRef" },
        "body_schema": { "$ref": "#/$defs/schemaRef" }
      }
    },
    "responseShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header_schema": { "$ref": "#/$defs/schemaRef" },
        "trailer_schema": { "$ref": "#/$defs/schemaRef" },
        "body_schema": { "$ref": "#/$defs/schemaRef" },
        "error_schema": { "$ref": "#/$defs/schemaRef" }
      }
    }
,
    "OresTraceId": {
      "$id": "OresTraceId",
      "description": "Static call-site trace identifier emitted as an inline literal by the generator: the fixed prefix ores-trace- followed by a 21-character nanoid alphabet run. Independently authored peer of the ores-otel/ores.otel.log contracts/ores-ids declaration of the same name.",
      "type": "string",
      "pattern": "^ores-trace-[A-Za-z0-9_-]{21}$"
    },
    "OresRoutineId": {
      "$id": "OresRoutineId",
      "description": "Static routine identifier declared once per generated dispatch function: the fixed prefix ores-routine- followed by a 21-character nanoid alphabet run. Independently authored peer of the ores-otel/ores.otel.log contracts/ores-ids declaration of the same name.",
      "type": "string",
      "pattern": "^ores-routine-[A-Za-z0-9_-]{21}$"
    },
    "RpcErrorTransport": {
      "$id": "RpcErrorTransport",
      "description": "Carrier the failed invocation arrived on. Identity only; no address, authority, path or header value is ever recorded.",
      "type": "string",
      "enum": ["rpc", "http", "in_process"]
    },
    "RpcDispatchOutcome": {
      "$id": "RpcDispatchOutcome",
      "description": "What the guarded dispatch did. A guarded dispatch that succeeds emits no RpcErrorLogEvent at all.",
      "type": "string",
      "enum": ["error", "panic", "timeout", "cancelled"]
    },
    "RpcErrorKind": {
      "$id": "RpcErrorKind",
      "description": "Coarse, language-neutral classification of the trapped failure. Closed set so that a new kind is a contract change rather than a free-text channel.",
      "type": "string",
      "enum": [
        "transport",
        "codec",
        "validation",
        "authorization",
        "not_found",
        "conflict",
        "rate_limited",
        "unavailable",
        "timeout",
        "cancelled",
        "panic",
        "internal"
      ]
    },
    "RpcErrorLogEvent": {
      "$id": "RpcErrorLogEvent",
      "description": "The one telemetry event a guarded RPC dispatch emits before re-raising the error. The property set is closed and payload-free by construction: there is no request or response body, no path or query value, no header, no meta object and no user data anywhere in the shape, and additionalProperties false turns any attempt to add one into an admission failure rather than a leak.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_key",
        "transport",
        "outcome",
        "error_kind",
        "error_code",
        "trace_id",
        "re_raised",
        "payload_omitted"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "operation_key": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "transport": { "$ref": "#/$defs/RpcErrorTransport" },
        "outcome": { "$ref": "#/$defs/RpcDispatchOutcome" },
        "error_kind": { "$ref": "#/$defs/RpcErrorKind" },
        "error_code": {
          "description": "Stable, generator-assigned code. Never an exception message, stack, or any value derived from the request.",
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "trace_id": { "$ref": "#/$defs/OresTraceId" },
        "routine_id": { "$ref": "#/$defs/OresRoutineId" },
        "re_raised": {
          "description": "True records that the trapped error was re-raised (returned unchanged, rethrown, resume_unwind-ed or re-panicked) instead of swallowed.",
          "type": "boolean"
        },
        "payload_omitted": {
          "description": "Explicit machine-checkable declaration that the event carries no payload data. Always true.",
          "const": true
        }
      }
    }
  }
}
