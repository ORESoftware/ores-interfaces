{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-interfaces/raw/main/contracts/rpc-payload/v1/authored.schema.json",
  "title": "ORES RPC payload policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "default_codec",
    "allowed_codecs",
    "framing",
    "max_encoded_bytes",
    "max_decoded_bytes"
  ],
  "properties": {
    "schema": {
      "const": "ores.rpc-payload-policy/v1"
    },
    "default_codec": {
      "enum": [
        "json",
        "messagepack",
        "cbor",
        "protobuf",
        "raw"
      ]
    },
    "allowed_codecs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "json",
          "messagepack",
          "cbor",
          "protobuf",
          "raw"
        ]
      }
    },
    "framing": {
      "enum": [
        "http_body",
        "tcp_length_delimited",
        "websocket_message"
      ]
    },
    "max_encoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "max_decoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    }
  }
}
