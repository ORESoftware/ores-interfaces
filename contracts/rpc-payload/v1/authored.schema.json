{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ores-interfaces/raw/main/contracts/rpc-payload/v1/authored.schema.json",
  "$defs": {
    "PayloadCodec": {
      "type": "string",
      "enum": [
        "json",
        "messagepack",
        "cbor",
        "protobuf",
        "raw"
      ]
    },
    "TransportFraming": {
      "type": "string",
      "enum": [
        "http_body",
        "tcp_length_delimited",
        "websocket_message"
      ]
    },
    "RpcPayloadPolicyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "default_codec",
        "allowed_codecs",
        "framing",
        "max_encoded_bytes",
        "max_decoded_bytes",
        "preserve_opaque_bytes",
        "semantic_validation_after_decode",
        "raw_requires_explicit_binary_semantics"
      ],
      "properties": {
        "schema": {
          "const": "ores.rpc-payload-policy/v1"
        },
        "default_codec": {
          "$ref": "#/$defs/PayloadCodec"
        },
        "allowed_codecs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/PayloadCodec"
          }
        },
        "framing": {
          "$ref": "#/$defs/TransportFraming"
        },
        "max_encoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_decoded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "preserve_opaque_bytes": {
          "type": "boolean"
        },
        "semantic_validation_after_decode": {
          "const": true
        },
        "raw_requires_explicit_binary_semantics": {
          "const": true
        }
      }
    }
  },
  "$ref": "#/$defs/RpcPayloadPolicyV1"
}
