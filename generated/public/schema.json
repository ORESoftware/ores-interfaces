{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ores-otel/ores-interfaces/validation/public-contracts.v1.json",
  "title": "ORES telemetry public validation contracts",
  "contractVersion": "ores.validation.v1",
  "visibility": "public",
  "routeAuthority": "https://github.com/ORESoftware/api-docs",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/RequestMeta" },
    { "$ref": "#/$defs/PageQuery" },
    { "$ref": "#/$defs/ProblemDetails" },
    { "$ref": "#/$defs/GitHubActionsBuildLogEvent" }
  ],
  "$defs": {
    "RequestMeta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "RequestMeta",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "traceId"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 64 }
      }
    },
    "PageQuery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PageQuery",
      "type": "object",
      "additionalProperties": false,
      "required": ["limit"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "ProblemDetails": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "ProblemDetails",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "requestId"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 512 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string", "maxLength": 4096 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "GitHubActionsLogStream": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "GitHubActionsLogStream",
      "type": "string",
      "enum": ["stdout", "stderr"]
    },
    "GitHubActionsBuildLogEvent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "GitHubActionsBuildLogEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "organization", "repository", "workflow", "runId", "runAttempt",
        "jobId", "jobName", "headSha", "ref", "runnerOs", "runnerArch", "stream", "sequence",
        "eventId", "observedAt", "text", "redacted", "truncated"
      ],
      "properties": {
        "schemaVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "organization": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "workflow": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runAttempt": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "jobName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "headSha": { "type": "string", "minLength": 40, "maxLength": 40 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 },
        "runnerOs": { "type": "string", "minLength": 1, "maxLength": 64 },
        "runnerArch": { "type": "string", "minLength": 1, "maxLength": 64 },
        "stream": { "$ref": "GitHubActionsLogStream" },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "observedAt": { "type": "string", "minLength": 20, "maxLength": 64 },
        "text": { "type": "string", "maxLength": 65536 },
        "redacted": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "traceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "spanId": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "PublicValidationContract": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PublicValidationContract",
      "oneOf": [
        { "$ref": "RequestMeta" },
        { "$ref": "PageQuery" },
        { "$ref": "ProblemDetails" },
        { "$ref": "GitHubActionsBuildLogEvent" }
      ]
    }
  },
  "x-ores-routeBindings": []
}
